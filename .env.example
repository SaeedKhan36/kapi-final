# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development

# ---- Database ----
# Unset DATABASE_URL to use embedded PGlite. Production requires PostgreSQL.
DATABASE_URL=
KAPI_PGLITE_DIR=.kapi/db
KAPI_DB_POOL_MAX=24
KAPI_DB_IDLE_TIMEOUT=20
KAPI_DB_MAX_LIFETIME=1800

# ---- Queue ----
KAPI_LEASE_SECONDS=90
KAPI_MAX_ATTEMPTS=3

# ---- Shared secrets ----
# Generate the encryption key with: openssl rand -base64 32
KAPI_SECRET_KEY=
# At least 32 random characters. Required by the API in production.
KAPI_SESSION_SECRET=
KAPI_METRICS_TOKEN=
# Optional dedicated HMAC salt; KAPI_SESSION_SECRET is the secure fallback.
KAPI_RATE_LIMIT_SALT=

# ---- Control plane ----
# Render supplies PORT. CONTROL_PLANE_PORT is the local fallback.
CONTROL_PLANE_PORT=8787
CONTROL_PLANE_PUBLIC_URL=http://host.docker.internal:8787
KAPI_WEB_URL=http://localhost:5173
KAPI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787
KAPI_MAX_BODY_BYTES=2097152
KAPI_RATE_LIMIT_PER_MINUTE=300
KAPI_EVENT_POLL_MS=1000

# ---- Authentication ----
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:8787/auth/callback

# ---- GitHub App ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GIT_AUTHOR_NAME=kapi-agent
GIT_AUTHOR_EMAIL=agent@kapi.local

# ---- Operations process ----
# Use "on" for one-process local development. Production Render uses "off" on
# the API and runs operations in the dedicated worker.
KAPI_OPERATIONS=on
# Unique per deployment whenever this process runs operations; never "default".
KAPI_PLANE_ID=local-development
KAPI_PROVISIONER=on
KAPI_SCHEDULER=on
KAPI_RECONCILER=on
KAPI_SCHEDULER_INTERVAL_MS=15000
KAPI_ACCOUNTING_INTERVAL_MS=10000
KAPI_RECONCILE_INTERVAL_MS=60000
KAPI_ORPHAN_GRACE_SECONDS=600
KAPI_RECONCILE_DELETE=false

# ---- VM provider ----
# local | docker | daytona. Production operations cannot use local.
VM_PROVIDER=local
KAPI_AGENT_IMAGE=kapi/agent:latest
# Optional local-provider state location; unset defaults to the OS temp directory.
# KAPI_LOCAL_STATE_DIR=/tmp/kapi-local-state
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
VM_IDLE_TTL_SECONDS=900
KAPI_PROVISION_TIMEOUT_SECONDS=120
KAPI_PROVISION_RETRY_SECONDS=15
# Set for authoritative cost reporting; otherwise VM cost is marked unavailable.
KAPI_DAYTONA_CENTS_PER_HOUR=

# ---- Agent and model limits ----
KAPI_MAX_STEPS=40
KAPI_KEEP_FULL_STEPS=6
KAPI_HEARTBEAT_MS=15000
KAPI_CAPTAIN_MAX_STEPS=60
KAPI_CAPTAIN_KEEP_FULL_STEPS=16
KAPI_REVIEW_MAX_STEPS=30
KAPI_REVIEW_KEEP_FULL_STEPS=10
KAPI_MAX_TOOL_OUTPUT=20000
KAPI_COMMAND_TIMEOUT_MS=300000
KAPI_MAX_LLM_REQUESTS=2000
KAPI_MAX_LLM_TOKENS=20000000
KAPI_MODEL_CALL_TIMEOUT_MS=120000
KAPI_QUOTA_COOLDOWN_MS=900000
# Overrides can only reorder models already permitted by the Codex catalog.
KAPI_MODELS_REASONING=gpt-5.6-sol
KAPI_MODELS_CODING=gpt-5.6-sol
KAPI_MODELS_CHEAP=gpt-5.6-sol
# Advanced endpoint overrides normally stay unset:
# KAPI_CODEX_AUTH_URL=https://auth.openai.com
# KAPI_CODEX_API_URL=https://chatgpt.com/backend-api/codex
# KAPI_CODEX_CLIENT_ID=<registered Codex OAuth client>

# ---- Web build and local Vite proxy ----
# Leave VITE_API_URL empty locally to use Vite's same-origin proxy. Set it to
# CONTROL_PLANE_PUBLIC_URL in the production static-site environment.
VITE_API_URL=
CONTROL_PLANE_URL=http://localhost:8787

# ---- Release probes (operator shell only) ----
KAPI_PREFLIGHT_ROLE=all
KAPI_SMOKE_URL=http://localhost:8787
KAPI_SMOKE_REQUIRE_PRODUCTION=false
KAPI_SMOKE_COOKIE=
KAPI_SMOKE_PROJECT_ID=
KAPI_STAGING_GOAL=
KAPI_STAGING_TIMEOUT_SECONDS=2700
KAPI_STAGING_POLL_SECONDS=10
KAPI_STAGING_KEEP_FAILED_RUN=false
KAPI_RESTORE_DATABASE_URL=
KAPI_RESTORE_CONFIRM_ISOLATED=false
KAPI_RESTORE_EXPECTED_COUNTS=
