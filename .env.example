# ---- Database ----
# Unset -> embedded PGlite in .kapi/db (zero setup, single-process).
# Set   -> real Postgres. REQUIRED to run the queue concurrency test, because
#          PGlite serialises transactions and never contends FOR UPDATE SKIP LOCKED.
#   docker run -d --name kapi-pg -p 5432:5432 -e POSTGRES_PASSWORD=kapi postgres:16
#   DATABASE_URL=postgres://postgres:kapi@localhost:5432/postgres
DATABASE_URL=

# ---- Queue ----
# How long a claimed job stays leased before the reaper may requeue it.
# Agents must heartbeat well inside this window.
KAPI_LEASE_SECONDS=90
KAPI_MAX_ATTEMPTS=3

# ---- Secrets vault ----
# 32-byte key, base64. Generate: openssl rand -base64 32
KAPI_SECRET_KEY=

# ---- Control plane ----
CONTROL_PLANE_PORT=8787
CONTROL_PLANE_PUBLIC_URL=http://host.docker.internal:8787
KAPI_WEB_URL=http://localhost:5173
KAPI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787
KAPI_SESSION_SECRET=
KAPI_METRICS_TOKEN=
KAPI_RATE_LIMIT_PER_MINUTE=300

# ---- Auth (Phase 1) ----
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:8787/auth/callback

# ---- VMs (Phase 2) ----
# local | docker | daytona
VM_PROVIDER=local
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
VM_IDLE_TTL_SECONDS=900
KAPI_ORPHAN_GRACE_SECONDS=600
KAPI_RECONCILE_DELETE=false
KAPI_DAYTONA_CENTS_PER_HOUR=

# ---- Operations ----
KAPI_SCHEDULER_INTERVAL_MS=15000
KAPI_ACCOUNTING_INTERVAL_MS=10000
KAPI_RECONCILE_INTERVAL_MS=60000

# ---- Models (Phase 3) ----
# Model calls use the user's Codex subscription exclusively. Connect it through
# POST /api/connections/codex/start; no provider API key is read from the env.

# ---- GitHub (Phase 6) ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional but strongly recommended. When set, unsigned webhooks are rejected.
GITHUB_WEBHOOK_SECRET=
GIT_AUTHOR_NAME=kapi-agent
GIT_AUTHOR_EMAIL=agent@kapi.local
