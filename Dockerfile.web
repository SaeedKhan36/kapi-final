FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps/web ./apps/web
COPY packages ./packages
RUN pnpm install --frozen-lockfile
# Azure exposes the API through the gateway's own origin, so the browser build
# must keep API URLs relative.
RUN VITE_API_URL= pnpm build:web

FROM nginx:1.29.5-alpine AS runtime
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY deploy/azure/nginx.conf.template /etc/kapi/nginx.conf.template
COPY deploy/azure/web-entrypoint.sh /usr/local/bin/kapi-web
RUN chmod 0555 /usr/local/bin/kapi-web \
  && chown -R nginx:nginx /usr/share/nginx/html /etc/kapi
USER nginx
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/kapi-web"]
